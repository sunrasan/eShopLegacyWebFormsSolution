@page "/Catalog/Delete/{id:int}"
@model eShopLegacyWebForms.Web.Pages.Catalog.DeleteModel
@{
    ViewData["Title"] = "Delete Catalog Item";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h1 class="mb-4 text-danger">Delete Catalog Item</h1>

            @if (Model.Item == null)
            {
                <div class="alert alert-warning">Item not found.</div>
                <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
            }
            else
            {
                <div class="alert alert-warning">
                    <strong>Warning!</strong> Are you sure you want to delete this item? This action cannot be undone.
                </div>

                <div class="card mb-4">
                    <div class="row g-0">
                        <div class="col-md-4">
                            <img src="~/pics/@Model.Item.PictureFileName" class="img-fluid rounded-start"
                                 alt="@Model.Item.Name"
                                 onerror="this.src='/images/brand.png'" />
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title">@Model.Item.Name</h5>
                                <p class="card-text text-muted">@Model.Item.Description</p>
                                <dl class="row">
                                    <dt class="col-sm-5">Price</dt>
                                    <dd class="col-sm-7">@Model.Item.Price.ToString("C")</dd>

                                    <dt class="col-sm-5">Brand</dt>
                                    <dd class="col-sm-7">@Model.Item.CatalogBrandName</dd>

                                    <dt class="col-sm-5">Type</dt>
                                    <dd class="col-sm-7">@Model.Item.CatalogTypeName</dd>

                                    <dt class="col-sm-5">Available Stock</dt>
                                    <dd class="col-sm-7">@Model.Item.AvailableStock</dd>
                                </dl>
                            </div>
                        </div>
                    </div>
                </div>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Item.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Confirm Delete
                        </button>
                        <a asp-page="./Details" asp-route-id="@Model.Item.Id" class="btn btn-info">Details</a>
                        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
